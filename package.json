{
  "name": "natively",
  "version": "2.9.2",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Natively is a meeting notes app that uses AI to generate notes from your meetings.",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && node node_modules/typescript7/lib/tsc.js -p tsconfig.json && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:core-smoke": "cross-env NATIVELY_CORE_SMOKE=1 node scripts/build-electron.js",
    "typecheck:electron": "node node_modules/typescript7/lib/tsc.js -p electron/tsconfig.json --noEmit",
    "typecheck:premium": "node node_modules/typescript7/lib/tsc.js -p electron/tsconfig.premium-check.json --noEmit",
    "typecheck:ts5": "tsc -p tsconfig.json --noEmit",
    "typecheck:ts5:electron": "tsc -p electron/tsconfig.json --noEmit",
    "typecheck:ts7": "node node_modules/typescript7/lib/tsc.js -p tsconfig.json --noEmit",
    "typecheck:ts7:electron": "node node_modules/typescript7/lib/tsc.js -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "postinstall": "patch-package && cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm rebuild sharp && node scripts/rebuild-native-electron.js && node scripts/download-models.js && node scripts/ensure-sqlite-vec.js && node scripts/ensure-napi-canvas-mac-deps.js && node scripts/patch-electron-plist.js && node scripts/verify-native-arch.js",
    "rebuild:native": "node scripts/rebuild-native-electron.js && node scripts/verify-native-arch.js",
    "prepare": "husky",
    "electron:dev": "npm run build && npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build:electron && cross-env NODE_ENV=production electron .",
    "app:dev": "concurrently --kill-others --kill-signal SIGKILL \"npm run dev -- --host 127.0.0.1 --port 5180 --strictPort\" \"wait-on http://127.0.0.1:5180 && npm run electron:dev\"",
    "dev:agent": "node scripts/dev-agent.mjs",
    "app:build": "npm run build && npm run typecheck:electron && npm run build:electron && cross-env NATIVELY_BUILD_ALL_MAC_ARCHES=1 npm run build:native && node scripts/ensure-sharp-mac-deps.js && node scripts/ensure-napi-canvas-mac-deps.js && node scripts/ensure-sqlite-vec.js && npm run verify:packaged-local-assets && node scripts/package-app.js",
    "app:build:signed": "node scripts/preflight-notary.cjs && npm run build && npm run typecheck:electron && npm run build:electron && cross-env NATIVELY_BUILD_ALL_MAC_ARCHES=1 npm run build:native && node scripts/ensure-sharp-mac-deps.js && node scripts/ensure-napi-canvas-mac-deps.js && node scripts/ensure-sqlite-vec.js && npm run verify:packaged-local-assets && node scripts/package-app.js --config electron-builder.signed.cjs",
    "watch": "node scripts/build-electron.js --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build",
    "dist:signed": "npm run app:build:signed && node scripts/upload-release.mjs",
    "build:native": "node scripts/build-native.js",
    "test": "npm run build:electron && node scripts/run-with-env.mjs --default-tmpdir NATIVELY_TEST_USERDATA=natively-test-userdata --default-tmpdir CODEX_HOME=natively-test-codex-home --set ELECTRON_RUN_AS_NODE=1 -- electron --test \"electron/services/__tests__/**/*.test.mjs\" \"electron/services/extensions/__tests__/**/*.test.mjs\" \"electron/intelligence/autoAnswer/__tests__/**/*.test.mjs\" \"electron/lib/__tests__/**/*.test.mjs\" \"electron/llm/__tests__/**/*.test.mjs\" \"electron/llm/codeVerification/__tests__/**/*.test.mjs\" \"electron/audio/__tests__/**/*.test.mjs\" \"electron/audio/whisper/__tests__/**/*.test.mjs\" \"electron/audio/whisper/nemotron/__tests__/**/*.test.mjs\" \"electron/audio/whisper/parakeet/__tests__/**/*.test.mjs\" \"electron/rag/__tests__/**/*.test.mjs\" \"electron/utils/__tests__/**/*.test.mjs\" \"electron/update/**/*.test.mjs\"",
    "test:auto-answer": "npm run build:electron && node scripts/run-with-env.mjs --default-tmpdir NATIVELY_TEST_USERDATA=natively-auto-answer-test-userdata --default-tmpdir CODEX_HOME=natively-auto-answer-test-codex-home --set ELECTRON_RUN_AS_NODE=1 -- electron --test \"electron/intelligence/autoAnswer/__tests__/**/*.test.mjs\"",
    "test:auto-answer:judge": "npm run build:electron && node electron/intelligence/autoAnswer/__tests__/judgeEval.mjs",
    "test:auto-answer:judge-gate": "npm run build:electron && node electron/intelligence/autoAnswer/__tests__/judgeEvalGate.mjs",
    "test:intelligence": "npm run build:electron && node --test \"electron/intelligence/__tests__/**/*.test.mjs\" \"electron/context-intelligence/__tests__/**/*.test.mjs\"",
    "test:core-smoke": "node --test \"electron/llm/__tests__/DirectAssistCore2026_08_29.test.mjs\" \"electron/services/__tests__/DirectAssistIpcBridge2026_08_29.test.mjs\" \"electron/services/__tests__/ScreenshotOutranksTextDecline2026_08_19.test.mjs\" \"electron/services/__tests__/SsrfProtection.test.mjs\" \"electron/context-intelligence/__tests__/AnswerTrace.test.mjs\" \"electron/context-intelligence/__tests__/LegacyTrace.test.mjs\" \"electron/context-intelligence/__tests__/ScreenCodeAskCodingTask2026_08_05.test.mjs\" \"electron/audio/__tests__/AppleSpeechSTT.test.mjs\" \"electron/services/__tests__/SttAwaitingAudioInitialState.test.mjs\"",
    "test:lib": "node --experimental-strip-types --test \"src/lib/**/__tests__/**/*.test.mjs\"",
    "test:components": "node --experimental-strip-types --test \"src/components/**/__tests__/**/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/__tests__/**/*.test.mjs\"",
    "test:company-research-spend": "npm run build:electron && node --test premium/electron/knowledge/__tests__/CompanyResearchForceRefresh2026_09_21.test.mjs src/components/__tests__/CompanyResearchCtaWiring2026_09_21.test.mjs",
    "test:ci": "npm run typecheck:electron && npm run build && npm test && npm run test:intelligence && npm run test:lib && npm run test:components && npm run test:scripts && npm run test:company-research-spend",
    "test:modes": "npm run build:electron && node --test \"electron/services/__tests__/Mode*.test.mjs\" electron/services/__tests__/ProfileIntelligenceGate.test.mjs electron/services/__tests__/NativelyApiE2E.test.mjs",
    "test:modes:no-build": "node --test \"electron/services/__tests__/Mode*.test.mjs\" electron/services/__tests__/ProfileIntelligenceGate.test.mjs electron/services/__tests__/NativelyApiE2E.test.mjs",
    "test:modes:collect-fixtures": "cross-env RUN_INTERNET_FIXTURE_COLLECTION=1 node --test electron/services/__tests__/ModeFixtureIntegrity.test.mjs",
    "test:modes:e2e": "cross-env RUN_NATIVELY_API_E2E=1 npm run test:modes",
    "test:realtime-prompt": "npm run build:electron && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/e2e-wiring.cjs && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/e2e-wiring.cjs --v3=0 && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/e2e-typed-chat.cjs",
    "test:realtime-prompt:live": "npm run build:electron && cross-env RUN_REALTIME_PROMPT_LIVE=1 ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/live-e2e.cjs",
    "test:modes:long": "node --test electron/services/__tests__/ModeLongSession.test.mjs",
    "test:css": "npm run test:css:table && npm run test:css:resize-handle && npm run test:css:split-audio-select && npm run test:css:undetectable-ring && npm run test:css:cta-liquid-glass && npm run test:css:pricing-liquid-glass && npm run test:css:clear-variant && npm run test:css:thinking-label && npm run test:css:bubble-liquid-glass",
    "test:css:table": "electron tests/css/table-scrollbar.check.mjs",
    "test:css:resize-handle": "electron tests/css/resize-handle-cursor.check.mjs",
    "test:css:split-audio-select": "electron tests/css/split-audio-model-select.check.mjs",
    "test:css:undetectable-ring": "electron tests/css/undetectable-ring.check.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:parity": "node scripts/run-with-env.mjs --set ELECTRON_E2E=1 --default ELECTRON_APP_PORT=5173 -- playwright test tests/e2e/parity-gaps-evidence.spec.ts",
    "test:e2e:screen-understanding": "npm run build:electron && node natively-api/tests/screen-understanding-live.e2e.mjs",
    "bench:screen-understanding": "npm run build:electron && node scripts/bench-screen-understanding.mjs",
    "benchmark:vision": "npm run build:electron && node dist-electron/electron/visionBenchmark/cli.js",
    "benchmark:vision:live": "npm run build:electron && node scripts/run-live-vision-benchmark.mjs",
    "test:vision-benchmark": "npm run build:electron && node --test \"electron/visionBenchmark/__tests__/*.test.mjs\"",
    "benchmark:profile:dataset": "node benchmarks/profile-intelligence/generate_dataset.ts",
    "benchmark:profile": "cross-env NODE_NO_WARNINGS=1 node benchmarks/profile-intelligence/run_profile_intelligence_benchmark.ts",
    "benchmark:profile:300": "cross-env NODE_NO_WARNINGS=1 node benchmarks/profile-intelligence/run_profile_intelligence_benchmark.ts --questions=300 --concurrency=1",
    "benchmark:profile:1000": "cross-env NODE_NO_WARNINGS=1 node benchmarks/profile-intelligence/run_profile_intelligence_benchmark.ts --questions=1000 --concurrency=1",
    "benchmark:profile:score": "cross-env NODE_NO_WARNINGS=1 node benchmarks/profile-intelligence/score_profile_benchmark.ts",
    "benchmark:profile:build": "npm run build:electron && npm run benchmark:profile && npm run benchmark:profile:score",
    "benchmark:wta": "cross-env NODE_NO_WARNINGS=1 node benchmarks/profile-intelligence/run_what_to_answer_benchmark.ts",
    "benchmark:wta:selection": "npm run build:electron && node benchmarks/profile-intelligence/run_selection_benchmark.mjs",
    "benchmark:wta:ledger": "npm run build:electron && node benchmarks/profile-intelligence/run_ledger_benchmark.mjs",
    "benchmark:wta:replay": "npm run build:electron && node benchmarks/profile-intelligence/run_conversation_replay.cjs",
    "benchmark:wta:75": "cross-env NODE_NO_WARNINGS=1 node benchmarks/profile-intelligence/run_what_to_answer_benchmark.ts --questions=75",
    "benchmark:wta:100": "cross-env NODE_NO_WARNINGS=1 node benchmarks/profile-intelligence/run_what_to_answer_benchmark.ts --questions=100",
    "benchmark:manual-regression": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_manual_chat_regression.ts",
    "benchmark:manual-sequential-stress": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_manual_sequential_stress_eval.ts",
    "benchmark:profile:1000:gemini31-flash-lite": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_profile_benchmark_1000.ts --concurrency=1",
    "benchmark:residual-failures": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_residual_failures.ts",
    "benchmark:multimode:1000": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_multimode_1000_eval.ts --concurrency=1",
    "benchmark:followup:500": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_followup_stability_eval.ts",
    "benchmark:longsession:100": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_long_session_eval.ts",
    "doctor": "npx react-doctor@latest",
    "test:intelligence:ui": "playwright test --config intelligence-eval-real-ui/playwright.config.ts",
    "test:intelligence:ui:headed": "playwright test --config intelligence-eval-real-ui/playwright.config.ts --headed",
    "test:intelligence:ui:debug": "cross-env PWDEBUG=1 playwright test --config intelligence-eval-real-ui/playwright.config.ts",
    "test:intelligence:ui:report": "playwright show-report intelligence-eval-real-ui/results/playwright-report",
    "eval:intelligence:ui": "node --experimental-strip-types intelligence-eval-real-ui/run-real-ui-e2e.ts",
    "test:intelligence:ui:grader": "node --experimental-strip-types intelligence-eval-real-ui/grader-unit-checks.mjs",
    "benchmark:livememory": "cross-env NODE_NO_WARNINGS=1 NATIVELY_ENABLE_LIVE_SESSION_MEMORY=on node benchmarks/profile-intelligence/run_live_session_memory_eval.ts",
    "test:llm": "npm run build:electron && node --test \"electron/llm/__tests__/**/*.test.mjs\" \"electron/llm/codeVerification/__tests__/**/*.test.mjs\"",
    "test:services": "npm run build:electron && node --test \"electron/services/__tests__/**/*.test.mjs\" \"electron/services/extensions/__tests__/**/*.test.mjs\"",
    "test:meeting-notes": "npm run build:electron && node --test \"electron/services/meeting/__tests__/**/*.test.mjs\"",
    "eval:meeting-notes": "npm run build:electron && cross-env NODE_NO_WARNINGS=1 node benchmarks/meeting-notes/run_meeting_notes_eval.mjs",
    "test:electron": "npm run build:electron && node scripts/run-with-env.mjs --default-tmpdir NATIVELY_TEST_USERDATA=natively-test-userdata --default-tmpdir CODEX_HOME=natively-test-codex-home --set ELECTRON_RUN_AS_NODE=1 -- electron --test \"electron/services/__tests__/**/*.test.mjs\"",
    "benchmark:answer-quality": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_best_in_class_eval.ts",
    "benchmark:live-replay:50": "cross-env NODE_NO_WARNINGS=1 NATIVELY_ENABLE_LIVE_SESSION_MEMORY=on node benchmarks/profile-intelligence/run_live_session_replay_eval.ts",
    "ci:tier1": "npm run build:electron && node --test \"electron/llm/__tests__/**/*.test.mjs\"",
    "ci:tier2": "npm run ci:tier1 && cross-env BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_residual_failures.ts",
    "ci:tier3": "npm run benchmark:multimode:1000 && npm run benchmark:followup:500 && npm run benchmark:longsession:100 && npm run benchmark:answer-quality",
    "ci:tier4": "npm run benchmark:livememory && npm run benchmark:live-replay:50 && npm run benchmark:wta:100 && npm run test:intelligence:ui",
    "benchmark:l4-aggregate": "node --experimental-strip-types benchmarks/profile-intelligence/aggregate_l4_progress.ts",
    "test:l4-aggregator": "node --test benchmarks/profile-intelligence/aggregate_l4_progress.selftest.mjs",
    "benchmark:manual-ui-truth": "cross-env NODE_NO_WARNINGS=1 BENCHMARK_MODEL=gemini-3.1-flash-lite node benchmarks/profile-intelligence/run_manual_ui_truth_eval.ts",
    "benchmark:reranker:run": "npm run build:electron && node benchmarks/reranker-eval/run.mjs",
    "benchmark:reranker:score": "node benchmarks/reranker-eval/score.mjs",
    "benchmark:reranker": "npm run benchmark:reranker:run && npm run benchmark:reranker:score",
    "verify:hindsight": "node scripts/verify-hindsight.mjs",
    "verify:packaged-local-assets": "node scripts/verify-packaged-local-assets.mjs",
    "verify:mac-app-local-assets": "node scripts/verify-packaged-local-assets.mjs",
    "smoke:packaged-local-fallback": "node scripts/smoke-packaged-local-fallback.mjs",
    "smoke:onnx-packaging": "node scripts/smoke-onnx-packaging.mjs",
    "release-gate": "node scripts/release-gate.mjs",
    "verify:memory-context": "npm run build:electron && node tests/intelligence/memory-context/run-verification.mjs",
    "verify:humanized-answers": "npm run build:electron && node scripts/verify-humanized-answers.mjs",
    "verify:spoken-quality": "npm run build:electron && node scripts/verify-spoken-quality.mjs",
    "test:node-runner": "npm run build:electron && node --test \"electron/services/__tests__/**/*.test.mjs\" \"electron/lib/__tests__/**/*.test.mjs\" \"electron/llm/__tests__/**/*.test.mjs\" \"electron/llm/codeVerification/__tests__/**/*.test.mjs\" \"electron/audio/__tests__/**/*.test.mjs\" \"electron/rag/__tests__/**/*.test.mjs\" \"electron/utils/__tests__/**/*.test.mjs\" \"electron/update/**/*.test.mjs\"",
    "test:api-smoke": "npm run build:electron && node scripts/run-with-env.mjs --default-tmpdir NATIVELY_TEST_USERDATA=natively-test-userdata --set ELECTRON_RUN_AS_NODE=1 -- electron --test electron/services/__tests__/NativelyApiE2E.test.mjs",
    "build:apple-speech": "node scripts/build-apple-speech.js",
    "test:css:cta-liquid-glass": "electron tests/css/cta-liquid-glass.check.mjs",
    "test:css:clear-variant": "electron tests/css/clear-variant-liquid-glass.check.mjs",
    "test:css:thinking-label": "electron tests/css/thinking-label.check.mjs",
    "test:css:pricing-liquid-glass": "electron tests/css/pricing-liquid-glass.check.mjs",
    "test:css:bubble-liquid-glass": "electron tests/css/bubble-liquid-glass.check.mjs",
    "test:meet-dom": "electron tests/meet/meet-dom.check.mjs",
    "test:phone-mirror": "node tests/phone-mirror/phone-mirror-client.check.mjs",
    "test:diagram": "node --experimental-strip-types --test \"src/lib/diagram/__tests__/**/*.test.mjs\" && npm run build:electron && node --test electron/llm/__tests__/DiagramContract2026_10_01.test.mjs electron/services/__tests__/DiagramPhoneAndSession2026_10_01.test.mjs electron/context-intelligence/__tests__/DiagramTurnComposition2026_10_01.test.mjs electron/services/__tests__/VisualCatalogWiring2026_10_01.test.mjs electron/services/__tests__/DiagramReviewFixes2026_10_01.test.mjs electron/llm/__tests__/LocalContextTrim2026_10_02.test.mjs electron/llm/__tests__/DiagramUndecided2026_10_02.test.mjs && npm run test:diagram:wiring:no-build && npm run test:diagram:render && npm run test:diagram:card && npm run test:diagram:overlay",
    "test:diagram:wiring": "npm run build:electron && npm run test:diagram:wiring:no-build",
    "test:diagram:wiring:no-build": "cross-env ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/e2e-diagram.cjs && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/e2e-diagram.cjs --v3=0 && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/e2e-visual-catalog.cjs && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/realtime-prompt/e2e-visual-catalog.cjs --v3=0",
    "test:diagram:render": "electron tests/diagram/mermaid-render.check.mjs",
    "test:diagram:card": "electron tests/diagram/diagram-card.check.mjs",
    "test:diagram:overlay": "node tests/diagram/overlay-stream.check.mjs",
    "test:diagram:live": "npm run build:electron && cross-env RUN_DIAGRAM_LIVE=1 ELECTRON_RUN_AS_NODE=1 electron tests/diagram/live-deepseek.cjs && node tests/diagram/live-replay.check.mjs"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.apple.corespeechd",
    "afterPack": "./scripts/after-pack.cjs",
    "afterAllArtifactBuild": "./scripts/afterAllArtifactBuild.default.cjs",
    "productName": "corespeechd",
    "files": [
      "dist",
      "dist-electron",
      "native-module",
      "package.json",
      "node_modules",
      "!**/native-module/target",
      "!**/native-module/src",
      "!**/native-module/.cargo",
      "!**/.env",
      "!**/.env.*",
      "!**/*.log",
      "!**/*.pdf",
      "!**/.git",
      "!**/node_modules/@typescript/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib",
      "**/whisperWorker.js",
      "**/localEmbeddingWorker.js",
      "**/localRerankerWorker.js",
      "**/ggufRerankerWorker.js",
      "**/routerWorker.js",
      "**/host/bootstrap.js",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/keytar/**",
      "**/node_modules/sqlite-vec/**",
      "**/node_modules/sqlite-vec-*/**",
      "**/node_modules/sharp/**",
      "**/node_modules/detect-libc/**",
      "**/node_modules/semver/**",
      "**/node_modules/@img/**",
      "**/node_modules/@napi-rs/**",
      "**/node_modules/@huggingface/transformers/**",
      "**/node_modules/@huggingface/jinja/**",
      "**/node_modules/onnxruntime-common/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-web/**",
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "assets/natively.icns",
        "to": "natively.icns"
      },
      {
        "from": "resources/models/",
        "to": "models/",
        "filter": [
          "Xenova/ms-marco-MiniLM-L-6-v2/**",
          "Xenova/multilingual-e5-small/**",
          "pipecat-ai/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/Natively.icon",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Natively-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "Natively",
        "NSScreenCaptureUsageDescription": "Natively needs Screen Recording permission to capture system audio for meeting transcription.",
        "NSMicrophoneUsageDescription": "Natively needs microphone access to transcribe your voice during meetings.",
        "NSAudioCaptureUsageDescription": "Natively needs system audio access to transcribe meeting audio.",
        "NSSpeechRecognitionUsageDescription": "Natively uses Apple Speech to transcribe meeting audio on your device."
      }
    },
    "dmg": {
      "title": "${productName}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "executableName": "audiodg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Natively-AI-assistant",
        "repo": "natively-cluely-ai-assistant",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "beforePack": "./scripts/rebuild-native-for-target.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@napi-rs/cli": "^3.5.1",
