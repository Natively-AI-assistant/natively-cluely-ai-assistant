// Check premium modules loaded through runtime require() calls, under strict TS.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  // ONLY premium is a root file. This repo's own electron/**/*.ts still enters
  // the program as a DEPENDENCY of these files (so premium is checked against
  // real types, not stubs), but its errors are not reported here — ./tsconfig.json
  // owns that, at full `strict`. Re-listing electron/ here would re-check it at a
  // DIFFERENT strictness and report 3 pre-existing TS7018s that `strict` does not
  // produce, which is noise this gate must not emit.
  "include": [
    "../premium/electron/**/*.ts",
    // The 45 recovered backend modules retain their original TypeScript source;
    // only the packaged search-provider modules remain JavaScript.
    "../premium/electron/**/*.js"
  ],
  // MUST be overridden, not inherited: ./tsconfig.json excludes "../premium/**",
  // which would cancel the include above and leave this config with no inputs
  // (TS18003) — a gate that silently checks nothing, which is the exact failure
  // mode this file was added to fix.
  "exclude": [
    "db/seedDemo.ts",
    "db/test-db.ts"
  ]
}
